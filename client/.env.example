# Pawgram client — optional local overrides.
# Copy to .env.local (gitignored) if you want to point this checkout at a
# different Supabase project or Ticketmaster key without editing source.
# The app ships with working defaults baked into
# src/services/supabaseClient.js and src/services/ticketmaster.js, so this
# file is optional.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TICKETMASTER_API_KEY=
